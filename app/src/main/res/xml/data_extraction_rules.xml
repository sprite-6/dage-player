<?xml version="1.0" encoding="utf-8"?>
<!-- 明确禁止云备份与设备迁移带走本地数据（含 NAS 口令、API Key 密文） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
